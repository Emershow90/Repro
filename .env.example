# ============================================================
# REPRO v2.0 — Environment Variables
# ------------------------------------------------------------
# Uso:  cp .env.example .env.local   (e preencher os valores)
# NUNCA commitar .env.local nem valores reais neste arquivo.
# ============================================================

# ------------------------------------------------------------
# ☁️  CLOUD RUN / AI STUDIO (injetadas automaticamente)
# ------------------------------------------------------------
# NÃO prefixar com VITE_ — vazaria para o bundle do cliente.
# Injetadas pelo runtime; não precisam ser preenchidas localmente.

# Chave da API Gemini (server-side apenas)
GEMINI_API_KEY=

# URL pública do applet (Cloud Run). Usada para OAuth callbacks
# e links auto-referenciais.
APP_URL=

# ------------------------------------------------------------
# 🗄️  CLOUD SQL (server-side apenas — NUNCA prefixar com VITE_)
# ------------------------------------------------------------
# Injetadas pelo Cloud Run. Se o app não usa SQL server-side,
# deixe em branco.

SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ------------------------------------------------------------
# 🔥 SUPABASE (client-side — expostas no bundle por design)
# ------------------------------------------------------------
# Estas DUAS variáveis são intencionalmente públicas.
# A anon/publishable key só permite o que o RLS autoriza.
# Prefixo VITE_ é obrigatório para o cliente enxergá-las.

# Obrigatório. Ex.: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Obrigatório. Formato novo: sb_publishable_...
# Requer @supabase/supabase-js >= 2.39.0
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# 📊 GOOGLE SHEETS (client-side — proxy recomendado)
# ------------------------------------------------------------
# Opcional. Se definida, o Tier 2 (Direct CORS) do sheetService
# usa esta chave. Prefira o proxy server-side /api/sheets/proxy
# para não expor a chave no bundle.

VITE_GOOGLE_SHEETS_API_KEY=

# URL do Google Apps Script (deploy do Web App).
# Pode ser configurada em runtime pela UI (aba Sheets Config).
VITE_GOOGLE_APPS_SCRIPT_URL=
