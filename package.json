{
  "name": "repro",
  "private": true,
  "version": "5.0.0",
  "description": "Terminal REPRO v5.0 — Reabastecimento e Produtividade em Tempo Real",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
"scripts": {
  "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
  "dev:server": "tsx watch server.ts",
  "dev:web": "vite",
  "dev:middleware": "tsx server.ts",

  "build": "npm run build:web && npm run build:server",
  "build:web": "tsc -b && vite build && node scripts/copy-404.mjs",
  "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",

  "start": "node dist/server.cjs",
  "start:prod": "NODE_ENV=production node dist/server.cjs",
  "preview": "vite preview",

  "clean": "rimraf dist node_modules",

  "typecheck": "tsc --noEmit",
  "lint": "biome check .",
  "lint:fix": "biome check --write .",
  "format": "biome format --write .",
  "format:check": "biome format .",

  "test": "vitest run",
  "test:watch": "vitest",
  "test:coverage": "vitest run --coverage",

  "validate:lock": "node scripts/validate-lockfile.mjs"
},
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "@use-gesture/react": "^10.3.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "odbc": "^2.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "node-fetch": "^3.3.2"
  },
  "browserslist": [
    "Chrome >= 110",
    "Safari >= 16",
    "Firefox >= 110",
    "Android >= 10"
  ]
}
